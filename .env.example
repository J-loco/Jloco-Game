# Copy to .env (git-ignored) and fill in. docker compose reads .env automatically.

# MariaDB root password (game/login servers and the web migration job). Must match database.*.pass in config/*.properties.
DB_ROOT_PASSWORD=change-me

# StarLoco-Web
# Password of the least-privilege "starloco_web" MariaDB account (created by starloco_web_migrate).
WEB_DB_PASSWORD=change-me-too
WEB_APP_URL=http://127.0.0.1/dofus/
WEB_APP_DEBUG=0
# 1 only when the site is behind Cloudflare (otherwise the client IP can be forged).
WEB_TRUST_CLOUDFLARE=0
# Empty hides the "Rechargement de points" tab.
WEB_DEDIPASS_PUBLIC_KEY=
